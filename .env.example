# Copy to .env and adjust. Read by the API and by `make` targets.

# API
APP_ENV=development
HTTP_ADDR=:8080
# Prometheus metrics (request latency, NFR-1), on a port that is never made public.
METRICS_ADDR=:9090
LOG_LEVEL=info
DATABASE_URL=postgres://vernacular:vernacular@localhost:5432/vernacular?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Object store (S3-compatible). Leave unset in development: make uses a local folder.
# Production example: s3://vernacular?endpoint=https://s3.example&use_path_style=true&region=auto
# BLOB_URL=

# Worker (make dev-worker). AI candidates call the Claude API and cost money.
# ANTHROPIC_API_KEY=
# AI_CONCURRENCY=4
# Google Translate candidates (bem, ny) run only when this is set.
# GOOGLE_TRANSLATE_API_KEY=

# Web (server-side only)
API_URL=http://localhost:8080
# The API's address as browsers reach it, for the API reference's request runner.
PUBLIC_API_URL=http://localhost:8080
# The portal's own API key, for pages anyone can see (ADR-0011). Create one on /account.
WEB_API_KEY=

# Web auth (Better Auth, ADR-0007). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Rate limits, requests per minute (DEV-3); 0 turns one off. TRUSTED_PROXIES lists
# the CIDRs of proxies whose X-Forwarded-For is believed, e.g. 10.0.0.0/8.
RATE_LIMIT_PER_KEY=120
RATE_LIMIT_PER_IP=30
TRUSTED_PROXIES=

# Pronunciation audio (LEX-8). Voice recordings are personal data: leave this off
# until the legal steps in tasks.md P2-08d are done.
AUDIO_ENABLED=false
