{
  "name": "@vernacular/client",
  "version": "0.1.0",
  "description": "JavaScript and TypeScript client for the Vernacular API: human-verified words and phrases in Zambian languages.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "openapi-typescript ../../contracts/openapi.yaml -o src/schema.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@vernacular/eslint-config": "workspace:*",
    "@vernacular/tsconfig": "workspace:*",
    "eslint": "^9",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5",
    "vitest": "^4"
  }
}
