{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "gen": {
      "inputs": ["$TURBO_ROOT$/contracts/openapi.yaml"],
      "outputs": ["src/schema.d.ts"]
    },
    "build": {
      "dependsOn": ["^build", "^gen"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": { "dependsOn": ["^gen"] },
    "typecheck": { "dependsOn": ["^gen"] },
    "test": { "dependsOn": ["^gen"] },
    "dev": { "dependsOn": ["^gen"], "cache": false, "persistent": true }
  }
}
