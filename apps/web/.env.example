# Base URL of the Go API, used by server components.
API_URL=http://localhost:8080
# The API as browsers reach it, for the API reference's request runner.
PUBLIC_API_URL=http://localhost:8080
# The portal's own API key, for pages anyone can see (ADR-0011). Create one on /account.
WEB_API_KEY=

# Auth (Better Auth). Same database as the API.
DATABASE_URL=postgres://vernacular:vernacular@localhost:5432/vernacular?sslmode=disable
# Web auth (Better Auth, ADR-0007). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3000
