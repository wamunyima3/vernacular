# Copy to deploy/.env.production (git-ignored) and fill in. See docs/deploy.md.

# Both names must point at the server (DNS A/AAAA records) before the first start.
WEB_DOMAIN=vernacular.example.org
API_DOMAIN=api.vernacular.example.org

# Generate each with: openssl rand -base64 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# The portal's own API key (ADR-0011). Leave empty for the first start, create a key on
# /account, set it here, then run `up -d` again.
WEB_API_KEY=

# Requests per minute (DEV-3). Raise the portal key's limit with care: it serves every
# signed-out visitor.
RATE_LIMIT_PER_KEY=120
RATE_LIMIT_PER_IP=30

# Worker only (--profile worker). AI candidates cost money.
ANTHROPIC_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
